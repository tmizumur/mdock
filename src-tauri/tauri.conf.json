{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mdock",
  "version": "0.1.0",
  "identifier": "com.mdock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mdock",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 15 },
        "theme": "Dark",
        "backgroundColor": "#0F1012",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": true,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: http: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown",
        "description": "Markdown 文書",
        "role": "Editor",
        "mimeType": "text/markdown",
        "rank": "Default"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMkRGNDQ0MUMwNEI5NEYKUldSUHVRUWNSUFF0YlRoQVdzQk0zaUttNk9ySVNlOW1pN2NNeVVYci9wU21kT0VjNFJtV1QyZEQK",
      "endpoints": [
        "https://github.com/tmizumur/mdock/releases/latest/download/latest.json"
      ]
    }
  }
}
